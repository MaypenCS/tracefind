# /etc/tracefind/tracefind.env  (chmod 600, owned by root)
# Settings for the PUBLIC TraceFind site. Your local copy keeps using its own .env.

# ---- Public mode
TRACEFIND_PUBLIC=1
# Real visitor IPs come from Cloudflare. Only safe because the service listens on 127.0.0.1.
TRACEFIND_TRUST_CLOUDFLARE=1
# Delete saved scans after 90 days (privacy: visitors' emails and results are personal data)
TRACEFIND_HISTORY_DAYS=90

# ---- Where data is stored (the service can't write anywhere else)
TRACEFIND_DB=/var/lib/tracefind/verify.db
TRACEFIND_HISTORY_DB=/var/lib/tracefind/history.db
TRACEFIND_CACHE_DIR=/var/lib/tracefind
# Signing secret: generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
TRACEFIND_SECRET=

# ---- Branding
TRACEFIND_BRAND_NAME=Maypen Cybersecurity
TRACEFIND_BRAND_DOMAIN=maypencs.net

# ---- Email (required: visitors need their verification codes)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=admin@maypencs.net
SMTP_PASSWORD=
SMTP_FROM=TraceFind <admin@maypencs.net>

# ---- Breach providers (XposedOrNot is free and on by default)
HIBP_API_KEY=
DEHASHED_API_KEY=
INTELX_API_KEY=
