# Copy this file to .env and fill in the keys you have. Every provider is optional.

# XposedOrNot is free and needs no key, so it's on by default.
# Free tier = personal / low-volume use (25 lookups/hour, 100/day). Set to 1 to turn it off.
TRACEFIND_DISABLE_XON=

# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Dehashed: https://dehashed.com (API access is a paid add-on)
DEHASHED_API_KEY=
# Intelligence X: https://intelx.io/account?tab=developer
INTELX_API_KEY=
# Free IntelX keys use https://free.intelx.io; paid keys usually use https://2.intelx.io
INTELX_BASE=https://free.intelx.io

# ---- Branding (shown in reports, verification emails and the domain scanner's User-Agent)
TRACEFIND_BRAND_NAME=Maypen Cybersecurity
# Your brand's website domain. Leave empty to show no domain.
TRACEFIND_BRAND_DOMAIN=

# ---- Email verification codes (needed before email breach results are shown)
# Leave SMTP_HOST empty while testing: codes are printed in the tracefind window instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TraceFind <no-reply@yourbrand.ca>
# Set to 1 for providers that use port 465 (SSL) instead of 587 (STARTTLS)
SMTP_SSL=0

# Optional: a long random string. If empty, one is generated into backend/.tracefind_secret
TRACEFIND_SECRET=
